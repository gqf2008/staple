#!/bin/sh
# Git credential helper for this repository.
#
# Resolves github.com credentials to the gqf2008 account token from the gh
# keyring, so `git push` works regardless of which account is globally active
# in `gh`. Falls back to the active account when gqf2008 is not configured on
# this machine (e.g. other contributors).
#
# Install (once, per checkout):
#   git config --local credential.https://github.com.helper \
#     "!<abs-path>/scripts/git-credential-gqf2008"

read_input() {
    while IFS= read -r line; do
        [ -z "$line" ] && break
        case "$line" in
            operation=*) op="${line#operation=}" ;;
        esac
    done
}

read_input

if [ "$op" = "fill" ]; then
    token="$(gh auth token --user gqf2008 2>/dev/null || gh auth token 2>/dev/null)"
    if [ -n "$token" ]; then
        echo "username=gqf2008"
        echo "password=$token"
    fi
fi
